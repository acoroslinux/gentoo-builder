{
  "packages": [
    "lxde-base/lxde-meta",
    "lxde-base/lxterminal",
    "x11-misc/pcmanfm",
    "sci-calculators/galculator",
    "lxde-base/lxappearance",
    "lxde-base/lxrandr",
    "lxde-base/lxtask",
    "lxde-base/lxinput",
    "app-arch/engrampa",
    "app-editors/mousepad",
    "gnome-extra/nm-applet",
    "media-sound/pavucontrol",
    "x11-misc/lightdm",
    "x11-misc/lightdm-gtk-greeter"
  ],
  "services": [
    "lightdm"
  ],
  "use_flags": [
    "X",
    "gtk",
    "gtk3",
    "lxde",
    "policykit",
    "udisks",
    "pam",
    "networkmanager",
    "screencast",
    "lock",
    "cups",
    "opengl",
    "egl"
  ],
  "desktop_environment": {
    "name": "lxde",
    "use_common_config": true,
    "customizations_path": "configs/custom_files/",
    "copy_files": [
      {
        "source": "desktops/lxde",
        "destination": "/etc/skel/.config"
      }
    ]
  }
}