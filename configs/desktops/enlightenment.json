{
  "packages": [
    "x11-wm/enlightenment",
    "dev-libs/efl",
    "x11-terms/terminology",
    "x11-fm/thunar",
    "app-editors/mousepad",
    "sci-calculators/galculator",
    "media-gfx/viewnior",
    "app-arch/xarchiver",
    "gnome-extra/nm-applet",
    "media-sound/pavucontrol",
    "x11-misc/lightdm",
    "x11-misc/lightdm-gtk-greeter",
    "gui-libs/display-manager-init"
  ],
  "services": [
    "lightdm"
  ],
  "use_flags": [
    "X",
    "enlightenment",
    "policykit",
    "udisks",
    "pam",
    "networkmanager",
    "opengl",
    "egl"
  ],
  "desktop_environment": {
    "name": "enlightenment",
    "use_common_config": true,
    "customizations_path": "configs/custom_files/",
    "copy_files": [
      {
        "source": "desktops/enlightenment",
        "destination": "/etc/skel/.config/e"
      }
    ]
  }
}