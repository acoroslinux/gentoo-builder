{
  "packages": [
    "gui-wm/sway",
    "gui-apps/swaybg",
    "x11-terms/foot",
    "gui-apps/waybar",
    "gui-apps/wofi",
    "gui-libs/wlroots",
    "gui-apps/grim",
    "gui-apps/slurp",
    "media-gfx/imv",
    "x11-fm/thunar",
    "app-editors/mousepad",
    "sci-calculators/galculator",
    "app-arch/xarchiver",
    "gnome-extra/nm-applet",
    "media-sound/pavucontrol",
    "x11-misc/sddm"
  ],
  "services": [
    "sddm"
  ],
  "use_flags": [
    "wayland",
    "gles2",
    "sway",
    "policykit",
    "udisks",
    "pam",
    "networkmanager",
    "opengl",
    "egl"
  ],
  "desktop_environment": {
    "name": "sway",
    "use_common_config": true,
    "customizations_path": "configs/custom_files/",
    "copy_files": [
      {
        "source": "desktops/sway",
        "destination": "/etc/skel/.config/sway"
      }
    ]
  }
}