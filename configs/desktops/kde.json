{
  "packages": [
    "kde-plasma/plasma-meta",
    "kde-apps/konsole",
    "kde-apps/dolphin",
    "kde-apps/kate",
    "kde-apps/gwenview",
    "kde-apps/ark",
    "kde-apps/okular",
    "kde-apps/kcalc",
    "kde-plasma/spectacle",
    "kde-plasma/discover",
    "kde-plasma/ksystemstats",
    "kde-plasma/plasma-systemmonitor",
    "kde-plasma/plasma-nm",
    "media-sound/pavucontrol-qt",
    "x11-misc/sddm"
  ],
  "services": [
    "sddm"
  ],
  "use_flags": [
    "X",
    "plasma",
    "wayland",
    "qt6",
    "qml",
    "kde",
    "policykit",
    "udisks",
    "pam",
    "networkmanager",
    "screencast",
    "lock",
    "cups",
    "avif",
    "vulkan",
    "minizip",
    "opengl",
    "egl"
  ],
  "desktop_environment": {
    "name": "plasma",
    "use_common_config": true,
    "customizations_path": "configs/custom_files/",
    "copy_files": [
      {
        "source": "desktops/kde",
        "destination": "/etc/skel/.config"
      }
    ]
  }
}