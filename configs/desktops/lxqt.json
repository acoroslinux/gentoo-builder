{
  "packages": [
    "lxqt-base/lxqt-meta",
    "x11-terms/qterminal",
    "app-arch/lxqt-archiver",
    "media-gfx/lximage-qt",
    "lxqt-base/lxqt-admin",
    "lxqt-base/lxqt-powermanagement",
    "lxqt-base/lxqt-sudo",
    "x11-misc/pcmanfm-qt",
    "x11-misc/screengrab",
    "media-sound/pavucontrol-qt",
    "x11-misc/sddm"
  ],
  "services": [
    "sddm"
  ],
  "use_flags": [
    "X",
    "lxqt",
    "qt6",
    "policykit",
    "udisks",
    "pam",
    "networkmanager",
    "screencast",
    "lock",
    "cups",
    "opengl",
    "egl"
  ],
  "desktop_environment": {
    "name": "lxqt",
    "use_common_config": true,
    "customizations_path": "configs/custom_files/",
    "copy_files": [
      {
        "source": "desktops/lxqt",
        "destination": "/etc/skel/.config"
      }
    ]
  }
}