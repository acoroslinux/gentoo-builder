{
  "packages": [
    "mate-base/mate",
    "mate-base/caja",
    "x11-terms/mate-terminal",
    "mate-extra/mate-power-manager",
    "mate-extra/mate-screensaver",
    "mate-extra/mate-media",
    "mate-extra/mate-utils",
    "mate-extra/mate-calc",
    "mate-extra/mate-system-monitor",
    "mate-extra/mate-tweak",
    "media-gfx/eom",
    "app-text/atril",
    "app-editors/pluma",
    "app-arch/engrampa",
    "gnome-extra/nm-applet",
    "x11-misc/lightdm",
    "x11-misc/lightdm-gtk-greeter"
  ],
  "services": [
    "lightdm"
  ],
  "use_flags": [
    "X",
    "gtk",
    "gtk3",
    "mate",
    "policykit",
    "udisks",
    "pam",
    "networkmanager",
    "screencast",
    "lock",
    "cups",
    "opengl",
    "egl",
    "introspection"
  ],
  "desktop_environment": {
    "name": "mate",
    "use_common_config": true,
    "customizations_path": "configs/custom_files/",
    "copy_files": [
      {
        "source": "desktops/mate",
        "destination": "/etc/skel/.config"
      }
    ]
  }
}