{
  "packages": [
    "x11-wm/qtile",
    "x11-misc/dmenu",
    "x11-terms/alacritty",
    "x11-misc/lightdm",
    "x11-misc/lightdm-gtk-greeter"
  ],
  "services": [
    "lightdm"
  ],
  "use_flags": [
    "X",
    "qtile",
    "policykit",
    "udisks",
    "pam",
    "networkmanager",
    "opengl",
    "egl"
  ],
  "desktop_environment": {
    "name": "qtile",
    "use_common_config": true,
    "customizations_path": "configs/custom_files/",
    "copy_files": [
      {
        "source": "desktops/qtile",
        "destination": "/etc/skel/.config/qtile"
      }
    ]
  }
}