{
  "packages": [
    "x11-wm/bspwm",
    "x11-misc/sxhkd",
    "x11-misc/polybar",
    "x11-misc/rofi",
    "x11-misc/dmenu",
    "x11-misc/picom",
    "x11-misc/feh",
    "x11-terms/alacritty",
    "x11-fm/thunar",
    "app-editors/mousepad",
    "sci-calculators/galculator",
    "media-gfx/viewnior",
    "app-arch/xarchiver",
    "gnome-extra/nm-applet",
    "media-sound/pavucontrol",
    "media-gfx/scrot",
    "x11-misc/lightdm",
    "x11-misc/lightdm-gtk-greeter",
    "gui-libs/display-manager-init"
  ],
  "services": [
    "lightdm"
  ],
  "use_flags": [
    "X",
    "bspwm",
    "policykit",
    "udisks",
    "pam",
    "networkmanager",
    "opengl",
    "egl"
  ],
  "desktop_environment": {
    "name": "bspwm",
    "use_common_config": true,
    "customizations_path": "configs/custom_files/",
    "copy_files": [
      {
        "source": "desktops/bspwm",
        "destination": "/etc/skel/.config/bspwm"
      }
    ]
  }
}