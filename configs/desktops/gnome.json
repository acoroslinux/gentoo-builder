{
  "packages": [
    "gnome-base/gnome",
    "gnome-extra/gnome-tweaks",
    "gnome-extra/gnome-shell-extensions",
    "gnome-extra/gnome-shell-extension-appindicator",
    "gnome-extra/gnome-shell-extension-dash-to-dock",
    "gnome-extra/gnome-backgrounds",
    "gnome-base/nautilus",
    "x11-terms/gnome-terminal",
    "media-gfx/eog",
    "app-editors/gedit",
    "gnome-extra/gnome-calculator",
    "gnome-extra/gnome-system-monitor",
    "app-text/evince",
    "app-arch/file-roller",
    "media-sound/pavucontrol"
  ],
  "services": [
    "gdm"
  ],
  "use_flags": [
    "X",
    "gnome",
    "wayland",
    "gtk",
    "gtk4",
    "introspection",
    "policykit",
    "opengl",
    "egl",
    "libei",
    "client",
    "pulseaudio",
    "vala",
    "server",
    "screencast",
    "cairo",
    "theora",
    "ogg",
    "vorbis",
    "eds"
  ],
  "desktop_environment": {
    "name": "gnome",
    "use_common_config": true,
    "customizations_path": "configs/custom_files/",
    "copy_files": [
      {
        "source": "desktops/gnome",
        "destination": "/etc/skel/.config"
      }
    ]
  }
}