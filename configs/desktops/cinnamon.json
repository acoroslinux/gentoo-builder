{
  "packages": [
    "gnome-extra/cinnamon",
    "gnome-extra/cinnamon-desktop",
    "gnome-extra/cinnamon-session",
    "gnome-extra/cinnamon-menus",
    "gnome-extra/cinnamon-translations",
    "gnome-extra/cinnamon-screensaver",
    "gnome-extra/cinnamon-control-center",
    "gnome-extra/cinnamon-settings-daemon",
    "x11-wm/muffin",
    "gnome-extra/nemo",
    "gnome-extra/nemo-fileroller",
    "app-arch/file-roller",
    "x11-terms/gnome-terminal",
    "app-editors/gedit",
    "media-gfx/eog",
    "x11-misc/lightdm",
    "x11-misc/lightdm-gtk-greeter"
  ],
  "services": [
    "lightdm"
  ],
  "use_flags": [
    "X",
    "gtk",
    "gtk3",
    "cinnamon",
    "policykit",
    "udisks",
    "pam",
    "networkmanager",
    "screencast",
    "lock",
    "cups",
    "opengl",
    "egl",
    "introspection"
  ],
  "desktop_environment": {
    "name": "cinnamon",
    "use_common_config": true,
    "customizations_path": "configs/custom_files/",
    "copy_files": [
      {
        "source": "desktops/cinnamon",
        "destination": "/etc/skel/.config"
      }
    ]
  }
}