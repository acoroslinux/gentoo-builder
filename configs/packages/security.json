{
  "name": "security",
  "description": "Firewalls, VPN, encryption, password managers, audit and backup tools",
  "packages": [
    "net-firewall/ufw",
    "net-firewall/nftables",
    "net-firewall/iptables",
    "app-admin/keepassxc",
    "app-backup/timeshift",
    "app-backup/rsync",
    "app-backup/borgbackup",
    "app-crypt/gnupg",
    "app-crypt/pinentry",
    "app-crypt/veracrypt",
    "net-vpn/openvpn",
    "net-vpn/wireguard-tools",
    "net-vpn/networkmanager-openvpn",
    "net-analyzer/wireshark",
    "net-analyzer/nmap",
    "sys-apps/apparmor",
    "app-forensics/lynis"
  ],
  "services": [
    "ufw",
    "nftables",
    "apparmor"
  ],
  "use_flags": [
    "gpg",
    "ssl",
    "openssl",
    "nls",
    "pam",
    "caps"
  ]
}
