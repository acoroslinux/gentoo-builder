{
  "name": "system-utils",
  "description": "Complete hardware firmware, CPU microcode, system monitoring, and administration suite",
  "packages": [
    "sys-kernel/linux-firmware",
    "sys-firmware/intel-microcode",
    "net-wireless/wireless-regdb",
    "sys-firmware/alsa-firmware",
    "sys-apps/pciutils",
    "sys-apps/usbutils",
    "sys-apps/hwinfo",
    "sys-apps/inxi",
    "sys-apps/lm-sensors",
    "app-admin/htop",
    "app-admin/iotop",
    "app-admin/sysstat",
    "app-editors/neovim",
    "app-editors/nano",
    "app-misc/fastfetch",
    "app-shells/zsh",
    "app-shells/zsh-completions",
    "app-text/tree",
    "net-misc/curl",
    "net-misc/wget",
    "sys-apps/bat",
    "sys-apps/fd",
    "sys-apps/ripgrep",
    "app-arch/7zip",
    "sys-power/cpupower",
    "sys-power/upower"
  ],
  "services": [
    "lm_sensors",
    "upower"
  ],
  "use_flags": [
    "ncurses",
    "python",
    "perl",
    "savedconfig"
  ]
}
