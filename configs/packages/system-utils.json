{
  "name": "system-utils",
  "description": "System monitoring, hardware info, power management, and administration utilities",
  "packages": [
    "app-admin/htop",
    "app-admin/iotop",
    "app-admin/sysstat",
    "app-editors/neovim",
    "app-editors/nano",
    "app-misc/neofetch",
    "app-misc/fastfetch",
    "app-shells/zsh",
    "app-shells/zsh-completions",
    "app-text/tree",
    "net-misc/curl",
    "net-misc/wget",
    "sys-apps/bat",
    "sys-apps/fd",
    "sys-apps/hwinfo",
    "sys-apps/inxi",
    "sys-apps/lm-sensors",
    "sys-process/lsof",
    "sys-apps/pciutils",
    "sys-apps/ripgrep",
    "sys-apps/usbutils",
    "app-arch/7zip",
    "sys-power/cpupower",
    "sys-power/upower"
  ],
  "services": [
    "lm_sensors",
    "upower"
  ],
  "use_flags": [
    "ncurses",
    "python",
    "perl"
  ]
}
