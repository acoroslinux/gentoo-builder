{
  "name": "audio",
  "description": "Complete audio stack: PipeWire/PulseAudio, ALSA, mixers and music players",
  "packages": [
    "media-sound/alsa-utils",
    "media-sound/pavucontrol",
    "media-sound/pulseaudio-daemon",
    "media-video/pipewire",
    "media-video/wireplumber",
    "media-sound/rhythmbox",
    "media-sound/deadbeef",
    "media-sound/qmmp",
    "media-sound/mp3gain",
    "media-sound/sox",
    "media-libs/alsa-lib",
    "media-libs/alsa-plugins",
    "media-plugins/alsa-plugins"
  ],
  "services": [
    "alsasound",
    "pipewire",
    "wireplumber"
  ],
  "use_flags": [
    "alsa",
    "pulseaudio",
    "pipewire",
    "sound",
    "bluetooth",
    "jack",
    "ogg",
    "flac",
    "mp3",
    "aac"
  ],
  "package_use": [
    "media-plugins/alsa-plugins pulseaudio",
    "media-sound/pulseaudio-daemon alsa bluetooth",
    "media-sound/pipewire alsa bluetooth jack sound-server"
  ]
}
