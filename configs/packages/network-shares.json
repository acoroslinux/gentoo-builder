{
  "name": "network-shares",
  "description": "Complete out-of-the-box Windows/Linux network file sharing stack (Samba, CIFS, NFS, SSHFS, GVFS, NSS-mDNS)",
  "packages": [
    "net-fs/samba",
    "net-fs/cifs-utils",
    "net-fs/nfs-utils",
    "net-fs/sshfs",
    "gnome-base/gvfs",
    "net-dns/avahi",
    "sys-auth/nss-mdns"
  ],
  "use_flags": [
    "samba",
    "client",
    "server",
    "nfs",
    "cifs",
    "fuse",
    "zeroconf",
    "udisks"
  ],
  "package_use": [
    "net-fs/samba client server winbind -ads -ldap",
    "gnome-base/gvfs samba cifs nfs fuse udisks http zeroconf -google archive",
    "net-dns/avahi dbus python mdnsresponder-compat -gtk -gtk3 -qt5 -qt6"
  ],
  "services": [
    "samba",
    "smb",
    "nfs",
    "avahi-daemon"
  ]
}
