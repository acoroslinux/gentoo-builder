{
  "name": "base",
  "description": "Essential base system utilities, shells, and CLI tools found in every mainstream distribution",
  "packages": [
    "app-admin/sudo",
    "app-admin/sysstat",
    "app-arch/tar",
    "app-arch/gzip",
    "app-arch/bzip2",
    "app-arch/xz-utils",
    "app-arch/unzip",
    "app-arch/zip",
    "app-arch/7zip",
    "app-editors/nano",
    "app-editors/neovim",
    "app-misc/tmux",
    "app-misc/screen",
    "app-shells/bash",
    "app-shells/bash-completion",
    "app-shells/zsh",
    "app-shells/zsh-completions",
    "app-text/tree",
    "sys-apps/less",
    "net-misc/curl",
    "net-misc/wget",
    "sys-apps/bat",
    "sys-apps/coreutils",
    "sys-apps/diffutils",
    "sys-apps/fd",
    "sys-apps/file",
    "sys-apps/findutils",
    "sys-apps/gawk",
    "sys-apps/grep",
    "sys-process/lsof",
    "sys-apps/man-db",
    "sys-apps/man-pages",
    "sys-apps/mlocate",
    "sys-apps/pciutils",
    "sys-process/procps",
    "sys-process/psmisc",
    "sys-apps/ripgrep",
    "sys-apps/sed",
    "sys-apps/shadow",
