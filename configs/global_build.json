{
  "global": {
    "distro": "Gentoo Modern",
    "version": "rolling",
    "maintainer": "AçorOS Linux Team",
    "workdir": "/tmp/gentoo-mock-build"
  },
  "stage3": {
    "url": "https://distfiles.gentoo.org/releases/amd64/autobuilds/latest-stage3-amd64-openrc.txt"
  },
  "make_conf": {
    "COMMON_FLAGS": "-O2 -pipe",
    "ACCEPT_LICENSE": "*",
    "VIDEO_CARDS": "amdgpu radeon radeonsi nouveau intel fbdev vesa",
    "INPUT_DEVICES": "libinput synaptics evdev"
  },
    "use_flags": [
      "unicode",
      "nls",
      "udev",
      "dbus",
      "text",
      "python",
    "mount",
    "alsa",
    "libproxy",
    "icu",
    "-openmp",
    "polkit",
    "udisks",
    "png",
    "harfbuzz",
    "jpeg",
    "svg",
    "ssl",
    "gnutls",
    "curl",
    "zstd",
    "lz4",
    "xattr",
    "pam",
    "acl",
    "attr",
    "dist-kernel",
    "-doc",
    "-gtk-doc",
    "-man",
    "-handbook"
  ],
  "packages": [
    "app-admin/sudo",
    "net-misc/dhcpcd",
    "net-misc/networkmanager",
    "sys-apps/util-linux",
    "sys-fs/lvm2",
    "sys-fs/cryptsetup",
    "sys-kernel/gentoo-kernel-bin"
  ],
  "services": [
    "dbus",
    "NetworkManager"
  ],
  "live_user": {
    "username": "live",
    "password": "live",
    "groups": ["wheel", "audio", "video", "input", "plugdev"]
  }
}
